{
  "name": "agodjie-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Agodjié TV — plateforme TVOD de séries dramatiques africaines",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test --trace off",
    "db:local": "bash scripts/local-db.sh",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.2.10",
    "@fontsource/roboto": "5.2.10",
    "hls.js": "1.7.4",
    "next": "15.5.29",
    "pg": "8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
