# Agodjié TV — variables d'environnement (AUCUNE valeur réelle ici).
# Les valeurs se saisissent dans les paramètres de l'hébergeur (Vercel / Supabase), jamais dans le dépôt.
# Voir TECHNICAL_ARCHITECTURE §8.

# Environnement applicatif : development | preview | production
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Base de données (serveur uniquement)
DATABASE_URL=
SUPABASE_URL=
# Clé « anon » : utilisée uniquement par le serveur (aucun client Supabase dans le navigateur).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secrets applicatifs (serveur uniquement)
HASH_SECRET=
CRON_SECRET=

# Authentification (Supabase Auth : Google + e-mail). L'identifiant Google OAuth et le SMTP
# se configurent dans le tableau de bord Supabase, pas ici.
APP_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Fournisseurs : simulator | <adaptateur réel>. Les simulateurs sont refusés en production (SEC-44).
PAYMENT_SIMULATOR_ENABLED=true
VIDEO_PROVIDER=simulator

# Identifiants par compte de paiement (préfixe = payment_accounts.credentials_ref)
# PAYACCT_<CODE>_API_KEY=
# PAYACCT_<CODE>_SITE_ID=
# PAYACCT_<CODE>_SECRET_KEY=
# PAYACCT_<CODE>_WEBHOOK_SECRET=

# Bunny Stream (étape 6)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_TOKEN_KEY=

# Anti-robot et suivi des erreurs
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Secret de signature du simulateur vidéo (développement uniquement)
SIMULATOR_SIGNING_SECRET=
